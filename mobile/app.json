{
  "expo": {
    "name": "SamePoint",
    "slug": "samepoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/same-point-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo/same-point-logo.png",
      "bundleIdentifier": "com.vview.samepoint"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo/same-point-logo-android.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vview.samepoint"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/logo/same-point-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/logo/same-point-logo.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/logo/same-point-dark-logo.png",
            "backgroundColor": "#111111"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.161519798851-n33nmncp21l1e2qlatho6m5lcub1ugrc"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d86136db-9bc1-4466-b2b4-2af2ad7ff3b3"
      }
    }
  }
}
